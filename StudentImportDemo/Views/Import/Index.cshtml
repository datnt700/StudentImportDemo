<style>
    body {
        font-family: Arial, sans-serif;
        margin: 24px;
        color: #1f2937;
        background: #f7f8fb;
    }

    .toolbar {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 18px;
    }

    button {
        border: 1px solid #2563eb;
        background: #2563eb;
        color: white;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    button:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .summary {
        display: flex;
        gap: 16px;
        align-items: center;
        margin-bottom: 18px;
        padding: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: white;
    }

    .summary strong {
        font-size: 18px;
    }

    .connection-status {
        margin-left: auto;
        font-size: 13px;
        color: #4b5563;
    }

    .success-text {
        color: #047857;
    }

    .processing-text {
        color: #1d4ed8;
    }

    .failed-text {
        color: #b91c1c;
    }

    .columns {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
    }

    .column {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: white;
        overflow: hidden;
    }

    .column-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
    }

    .record-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 180px;
        max-height: 520px;
        overflow: auto;
        padding: 12px;
    }

    .record {
        border: 1px solid #e5e7eb;
        border-left-width: 4px;
        border-radius: 6px;
        padding: 10px;
        background: #fbfdff;
        animation: rowIn .22s ease-out;
    }

    .record.success {
        border-left-color: #10b981;
    }

    .record.processing {
        border-left-color: #3b82f6;
        background: #eff6ff;
    }

    .record.failed {
        border-left-color: #ef4444;
    }

    .record-title {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .record-meta,
    .record-message {
        font-size: 13px;
        color: #4b5563;
        line-height: 1.4;
    }

    .record-message {
        margin-top: 6px;
        color: #991b1b;
    }

    @@keyframes rowIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 980px) {
        .columns {
            grid-template-columns: 1fr;
        }

        .summary,
        .toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .connection-status {
            margin-left: 0;
        }
    }
</style>

<div class="toolbar">
    <button id="importBtn">Import</button>
    <input id="fileInput" type="file" accept=".xlsx" />
</div>

<div class="summary">
    <strong>Summary</strong>
    <span class="success-text">Success: <span id="successCount">0</span></span>
    <span class="processing-text">Processing: <span id="processingCount">0</span></span>
    <span class="failed-text">Failed: <span id="failedCount">0</span></span>
    <span id="summaryMessage"></span>
    <span id="connectionStatus" class="connection-status">SignalR: disconnected</span>
</div>

<div class="columns">
    <section class="column">
        <div class="column-header processing-text">
            <span>Processing Records</span>
            <span id="processingColumnCount">0</span>
        </div>
        <div id="processingRows" class="record-list"></div>
    </section>

    <section class="column">
        <div class="column-header success-text">
            <span>Success Records</span>
            <span id="successColumnCount">0</span>
        </div>
        <div id="successRows" class="record-list"></div>
    </section>

    <section class="column">
        <div class="column-header failed-text">
            <span>Failed Records</span>
            <span id="failedColumnCount">0</span>
        </div>
        <div id="failedRows" class="record-list"></div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
<script>
    const rowRenderDelayMs = 250;
    const importIdStorageKey = "student-import-current-id";

    let success = 0;
    let failed = 0;
    let processing = 0;
    let currentImportId = getImportIdFromUrl() || localStorage.getItem(importIdStorageKey);
    let summaryFromServer = null;
    let isRenderingQueue = false;
    const renderQueue = [];
    const processingRecords = new Map();

    const importButton = document.getElementById("importBtn");
    const successCount = document.getElementById("successCount");
    const processingCount = document.getElementById("processingCount");
    const failedCount = document.getElementById("failedCount");
    const successColumnCount = document.getElementById("successColumnCount");
    const processingColumnCount = document.getElementById("processingColumnCount");
    const failedColumnCount = document.getElementById("failedColumnCount");
    const successRows = document.getElementById("successRows");
    const processingRows = document.getElementById("processingRows");
    const failedRows = document.getElementById("failedRows");
    const summaryMessage = document.getElementById("summaryMessage");
    const connectionStatus = document.getElementById("connectionStatus");

    const connection = new signalR.HubConnectionBuilder()
      .withUrl("/hubs/import")
      .withAutomaticReconnect()
      .build();

    connection.on("rowProcessed", row => {
      renderQueue.push(row);
      processRenderQueue();
    });

    connection.on("importSummary", summary => {
      summaryFromServer = summary;
      finishImportWhenQueueIsEmpty();
    });

    connection.onreconnecting(() => {
      connectionStatus.innerText = "SignalR: reconnecting...";
    });

    connection.onreconnected(async () => {
      connectionStatus.innerText = "SignalR: reconnected";

      if (currentImportId) {
        await connection.invoke("JoinImport", currentImportId);
        await reloadImportState(currentImportId);
      }
    });

    connection.onclose(() => {
      connectionStatus.innerText = "SignalR: disconnected";
    });

    restoreImportOnPageLoad();

    function getImportIdFromUrl() {
      return new URLSearchParams(window.location.search).get("importId");
    }

    function rememberImportId(importId) {
      localStorage.setItem(importIdStorageKey, importId);

      const url = new URL(window.location.href);
      url.searchParams.set("importId", importId);
      window.history.replaceState({}, "", url);
    }

    async function restoreImportOnPageLoad() {
      if (!currentImportId) {
        return;
      }

      summaryMessage.innerText = `Restoring import ${currentImportId}...`;
      await ensureSignalRStarted();
      await connection.invoke("JoinImport", currentImportId);
      await reloadImportState(currentImportId);
      connectionStatus.innerText = `SignalR: restored import ${currentImportId}`;
    }

    async function ensureSignalRStarted() {
      if (connection.state === signalR.HubConnectionState.Disconnected) {
        connectionStatus.innerText = "SignalR: connecting...";
        await connection.start();
        connectionStatus.innerText = "SignalR: connected via WebSocket";
      }
    }

    async function reloadImportState(importId) {
      const response = await fetch(`/api/import-jobs/${importId}`);
      if (!response.ok) {
        summaryMessage.innerText = "No saved import state found.";
        return;
      }

      const job = await response.json();
      renderQueue.length = 0;
      summaryFromServer = null;
      clearRecords();

      success = job.successCount;
      failed = job.failedCount;
      processing = 0;
      updateCounts();

      for (const row of job.rows) {
        appendRecord(row, row.status.toLowerCase());
      }

      summaryMessage.innerText = `Status: ${job.status}`;
    }

    async function processRenderQueue() {
      if (isRenderingQueue) {
        return;
      }

      isRenderingQueue = true;
      connectionStatus.innerText = "SignalR: receiving row events";

      while (renderQueue.length > 0) {
        const row = renderQueue.shift();
        applyRowEvent(row);
        updateCounts();
        await wait(rowRenderDelayMs);
      }

      isRenderingQueue = false;
      finishImportWhenQueueIsEmpty();
    }

    function applyRowEvent(row) {
      if (row.status === "Processing") {
        const key = getRowKey(row);
        if (!processingRecords.has(key)) {
          processing++;
        }

        const record = appendRecord(row, "processing");
        processingRecords.set(key, record);
        return;
      }

      removeProcessingRecord(row);

      if (row.status === "Success") {
        success++;
        appendRecord(row, "success");
        return;
      }

      failed++;
      appendRecord(row, "failed");
    }

    function removeProcessingRecord(row) {
      const key = getRowKey(row);
      const record = processingRecords.get(key);
      if (!record) {
        return;
      }

      record.remove();
      processingRecords.delete(key);
      processing = Math.max(0, processing - 1);
    }

    function getRowKey(row) {
      return `${row.rowNumber}|${row.studentCode ?? ""}`;
    }

    function finishImportWhenQueueIsEmpty() {
      if (!summaryFromServer || isRenderingQueue || renderQueue.length > 0) {
        return;
      }

      success = summaryFromServer.success;
      failed = summaryFromServer.failed;
      processing = 0;
      processingRecords.clear();
      processingRows.innerHTML = "";
      updateCounts();
      summaryMessage.innerText = summaryFromServer.message;
      connectionStatus.innerText = "SignalR: completed";
      importButton.disabled = false;
    }

    function resetUi() {
      success = 0;
      failed = 0;
      processing = 0;
      summaryFromServer = null;
      renderQueue.length = 0;
      clearRecords();
      summaryMessage.innerText = "Importing...";
      connectionStatus.innerText = "SignalR: preparing import";
      updateCounts();
    }

    function clearRecords() {
      processingRecords.clear();
      processingRows.innerHTML = "";
      successRows.innerHTML = "";
      failedRows.innerHTML = "";
    }

    function updateCounts() {
      successCount.innerText = success;
      processingCount.innerText = processing;
      failedCount.innerText = failed;
      successColumnCount.innerText = success;
      processingColumnCount.innerText = processing;
      failedColumnCount.innerText = failed;
    }

    function appendRecord(row, statusCssClass) {
      const target = getTargetList(statusCssClass);
      const record = document.createElement("article");
      record.className = `record ${statusCssClass}`;

      record.innerHTML = `
        <div class="record-title">
          <span>Row ${row.rowNumber}</span>
          <span>${row.status}</span>
        </div>
        <div class="record-meta">${row.studentCode ?? ""} ${row.fullName ? "- " + row.fullName : ""}</div>
        ${statusCssClass === "failed" ? `<div class="record-message">${row.message ?? "Unknown error"}</div>` : ""}
        ${statusCssClass === "processing" ? `<div class="record-meta">${row.message ?? "Processing row..."}</div>` : ""}
      `;

      target.appendChild(record);
      target.scrollTop = target.scrollHeight;
      return record;
    }

    function getTargetList(statusCssClass) {
      if (statusCssClass === "processing") {
        return processingRows;
      }

      if (statusCssClass === "success") {
        return successRows;
      }

      return failedRows;
    }

    function wait(milliseconds) {
      return new Promise(resolve => setTimeout(resolve, milliseconds));
    }

    document.getElementById("importBtn").addEventListener("click", async () => {
      const file = document.getElementById("fileInput").files[0];
      if (!file) {
        summaryMessage.innerText = "Please choose an .xlsx file first.";
        return;
      }

      resetUi();
      importButton.disabled = true;
      currentImportId = crypto.randomUUID();
      rememberImportId(currentImportId);

      await ensureSignalRStarted();
      await connection.invoke("JoinImport", currentImportId);
      connectionStatus.innerText = `SignalR: joined import ${currentImportId}`;

      const formData = new FormData();
      formData.append("file", file);
      formData.append("importId", currentImportId);

      const response = await fetch("/api/students/import", {
        method: "POST",
        body: formData
      });

      if (!response.ok) {
        const error = await response.json().catch(() => null);
        summaryMessage.innerText = error?.message ?? "Import failed.";
        connectionStatus.innerText = "SignalR: import request failed";
        importButton.disabled = false;
      }
    });
</script>